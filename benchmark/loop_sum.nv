// loop_sum.nv: tight integer-accumulation loop.
// Run with: bin/novel run benchmark/loop_sum.nv
//
// Stresses the simplest hot path: a single arithmetic loop. Modular arithmetic
// keeps the accumulator bounded so the checksum is exact and deterministic
// regardless of how the loop is later optimized.

import std.io
import std.time

const modulus = 1000000007

fn accumulate(iters int) int {
    let acc = 0
    for i = 1; i <= iters; i++ {
        acc = (acc + i * 3) % modulus
    }
    ret acc
}

fn main() {
    // Warmup: run a small pass so LuaJIT compiles the loop before timing.
    accumulate(100000)

    const iters = 700000000
    let t0 = time.now()
    let result = accumulate(iters)
    let dt = time.now() - t0

    io.println($"loop_sum\t{dt * 1000.0}\t{result}")
}
