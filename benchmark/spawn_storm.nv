// spawn_storm.nv: spawning a large number of short-lived green threads.
// Run with: bin/novel run benchmark/spawn_storm.nv
//
// Stresses thread creation and scheduling rather than per-thread compute. Each
// worker does a tiny bounded calculation and sends one result, so the cost is
// dominated by spawn + schedule + a single send/recv per thread. The checksum
// is the summed results, which is deterministic.

import std.io
import std.time

// worker does a small fixed amount of work, then reports a single value.
fn worker(id int, out chan<int>) {
    let acc = 0
    for k = 1; k <= 50; k++ {
        acc = (acc + id * k) % 100003
    }
    send(out, acc)
}

// run spawns count workers and sums their results back on the main thread.
// The buffer is sized to the worker count so producers never block.
fn run(count int) int {
    let out = chan<int>(count)
    for i = 1; i <= count; i++ {
        spawn worker(i, out)
    }
    let total = 0
    for i = 1; i <= count; i++ {
        total = (total + recv(out)) % 1000000007
    }
    ret total
}

fn main() {
    // Warmup so the spawn and send/recv sites are compiled before timing.
    run(5000)

    const workers = 2000000
    let t0 = time.now()
    let checksum = run(workers)
    let dt = time.now() - t0

    io.println($"spawn_storm\t{dt * 1000.0}\t{checksum}")
}
