// http_server.nv: a minimal HTTP server with std.http.
// Run with: bin/novel run examples/http_server.nv
// Then in another terminal: curl http://127.0.0.1:8080/        (or /time, /echo?x=1)
//
// Security: this is plaintext HTTP with no auth. It binds to 127.0.0.1 so it is
// only reachable from this machine; use "0.0.0.0" only when you intend to serve
// off-host, and validate everything a handler reads from a request.

import std.io
import std.http
import std.time

fn handle(req any) any {
    if req.path == "/" {
        ret http.response(200, "Hello from Novel!\n")
    }
    if req.path == "/time" {
        ret http.response(200, $"unix time: {time.unix()}\n")
    }
    ret http.response(404, "not found\n")
}

fn main() {
    let ln = http.serve("127.0.0.1", 8080, handle)
    if ln == nil {
        io.eprintln("failed to bind :8080")
        ret
    }
    io.println("listening on http://127.0.0.1:8080  (Ctrl-C to stop)")
    // Keep the program alive: park forever so the accept loop keeps serving.
    for {
        time.sleep(3600.0)
    }
}
